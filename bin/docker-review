#!/bin/bash
set -e

# CodeReviewer Docker One-Shot Script
# Usage:
#   bin/docker-review owner/repo 123
#   bin/docker-review https://github.com/owner/repo/pull/123
#   bin/docker-review owner/repo 123 --groups quality,testing
#   bin/docker-review owner/repo 123 --post

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

usage() {
    echo "Usage: $0 <repo|pr-url> [pr-number] [options]"
    echo ""
    echo "Arguments:"
    echo "  repo          Repository in owner/repo format"
    echo "  pr-number     Pull request number"
    echo "  pr-url        Full GitHub PR URL (e.g., https://github.com/owner/repo/pull/123)"
    echo ""
    echo "Options:"
    echo "  --groups      Comma-separated list of rule groups (blocking,testing,quality,etc.)"
    echo "  --post        Post review comments to GitHub"
    echo "  --debug       Enable debug logging"
    echo "  --rebuild     Force rebuild of Docker image"
    echo "  --help        Show this help message"
    echo ""
    echo "Examples:"
    echo "  $0 tmecklem/code_reviewer 123"
    echo "  $0 https://github.com/tmecklem/code_reviewer/pull/123"
    echo "  $0 tmecklem/code_reviewer 123 --debug"
    echo "  $0 tmecklem/code_reviewer 123 --groups quality,testing"
    echo "  $0 tmecklem/code_reviewer 123 --post"
    echo ""
    echo "Environment Variables:"
    echo "  GITHUB_TOKEN           Required for GitHub access"
    echo "  MCP_PORT              MCP server port (default: 4567)"
    echo ""
    echo "Notes:"
    echo "  - Claude authentication is required - ensure you're logged in via 'claude login'"
    echo "  - Your ~/.claude directory will be mounted read-only in the container"
    echo "  - MCP server runs automatically inside container"
    exit 1
}

# Parse arguments
REPO=""
PR_NUMBER=""
MIX_ARGS=()
REBUILD=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --help|-h)
            usage
            ;;
        --rebuild)
            REBUILD=true
            shift
            ;;
        --groups|--post|--debug)
            MIX_ARGS+=("$1")
            if [[ $1 == "--groups" ]]; then
                shift
                MIX_ARGS+=("$1")
            fi
            shift
            ;;
        *)
            if [[ -z "$REPO" ]]; then
                # First argument - could be repo or PR URL
                if [[ $1 =~ ^https://github\.com/([^/]+/[^/]+)/pull/([0-9]+) ]]; then
                    REPO="${BASH_REMATCH[1]}"
                    PR_NUMBER="${BASH_REMATCH[2]}"
                else
                    REPO="$1"
                fi
            elif [[ -z "$PR_NUMBER" ]]; then
                PR_NUMBER="$1"
            else
                echo -e "${RED}Error: Unexpected argument: $1${NC}"
                usage
            fi
            shift
            ;;
    esac
done

# Validate arguments
if [[ -z "$REPO" ]] || [[ -z "$PR_NUMBER" ]]; then
    echo -e "${RED}Error: Missing required arguments${NC}\n"
    usage
fi

# Validate environment variables
if [[ -z "$GITHUB_TOKEN" ]]; then
    echo -e "${RED}Error: GITHUB_TOKEN environment variable is required${NC}"
    echo "Set it with: export GITHUB_TOKEN='ghp_...'"
    exit 1
fi

# Print configuration
echo -e "${BLUE}╔════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║  CodeReviewer Docker One-Shot Review  ║${NC}"
echo -e "${BLUE}╚════════════════════════════════════════╝${NC}"
echo ""
echo -e "${GREEN}Repository:${NC}    $REPO"
echo -e "${GREEN}PR Number:${NC}     $PR_NUMBER"
if [[ ${#MIX_ARGS[@]} -gt 0 ]]; then
    echo -e "${GREEN}Options:${NC}       ${MIX_ARGS[*]}"
fi
echo ""

# Build Docker image if needed
IMAGE_NAME="code-reviewer:latest"

if [[ "$REBUILD" == true ]] || ! docker image inspect "$IMAGE_NAME" &> /dev/null; then
    echo -e "${YELLOW}Building Docker image...${NC}"
    cd "$PROJECT_ROOT"
    # Build with current user's UID, GID, and name for proper permissions
    docker build -f Dockerfile.production \
        --build-arg USER_ID=$(id -u) \
        --build-arg GROUP_ID=$(id -g) \
        --build-arg USER_NAME=$(whoami) \
        -t "$IMAGE_NAME" .
    echo -e "${GREEN}✓ Docker image built successfully${NC}"
    echo ""
else
    echo -e "${GREEN}✓ Using existing Docker image${NC}"
    echo ""
fi

# Create or use persistent Claude authentication volume
CLAUDE_VOLUME="code-reviewer-claude-auth"

# Check if volume exists, create if not
if ! docker volume inspect "$CLAUDE_VOLUME" &> /dev/null; then
    echo -e "${YELLOW}Creating persistent Claude authentication volume...${NC}"
    docker volume create "$CLAUDE_VOLUME"
fi

# Check if Claude is authenticated in the volume
echo -e "${YELLOW}Checking Claude authentication...${NC}"
AUTH_CHECK=$(docker run --rm \
    -v "$CLAUDE_VOLUME:/claude-auth" \
    --entrypoint /bin/bash \
    "$IMAGE_NAME" \
    -c "test -f /claude-auth/settings.local.json || test -f /claude-auth/.credentials.json && echo 'authenticated' || echo 'not-authenticated'")

echo "AUTH_CHECK result: '$AUTH_CHECK'"

if [[ "$AUTH_CHECK" != "authenticated" ]]; then
    echo -e "${YELLOW}Claude authentication required. Starting interactive authentication...${NC}"
    echo ""
    echo -e "${BLUE}Please complete the authentication process in your browser.${NC}"
    echo -e "${BLUE}Press 'c' to copy the login URL if the browser doesn't open automatically.${NC}"
    echo ""

    # Run interactive authentication
    docker run -it --rm \
        -v "$CLAUDE_VOLUME:/claude-auth" \
        -e INTERACTIVE_AUTH=true \
        --entrypoint /bin/bash \
        "$IMAGE_NAME" \
        -c "
            # Ensure claude-auth is writable
            mkdir -p /claude-auth
            chmod 755 /claude-auth

            # Create symlink for Claude to use
            rm -rf ~/.claude
            ln -s /claude-auth ~/.claude

            # Add Claude to PATH
            export PATH=\"/root/.local/bin:\$PATH\"

            # Run authentication
            claude login

            # Verify authentication
            if [ -f /claude-auth/settings.local.json ] || [ -f /claude-auth/.credentials.json ]; then
                echo ''
                echo '✓ Authentication successful!'
            else
                echo '✗ Authentication failed. Please try again.'
                exit 1
            fi
        "

    if [[ $? -ne 0 ]]; then
        echo -e "${RED}Authentication failed. Exiting.${NC}"
        exit 1
    fi

    echo -e "${GREEN}✓ Claude authentication complete${NC}"
    echo ""
fi

# Run the review
echo -e "${YELLOW}Starting review...${NC}"
echo ""

# Set MCP port
MCP_PORT="${MCP_PORT:-4567}"

docker run --rm \
    -v "$CLAUDE_VOLUME:/claude-auth" \
    -e GITHUB_TOKEN="$GITHUB_TOKEN" \
    -e MCP_PORT="$MCP_PORT" \
    "$IMAGE_NAME" \
    review "$REPO" "$PR_NUMBER" "${MIX_ARGS[@]}"

EXIT_CODE=$?

echo ""
if [[ $EXIT_CODE -eq 0 ]]; then
    echo -e "${GREEN}✓ Review completed successfully${NC}"
else
    echo -e "${RED}✗ Review failed with exit code $EXIT_CODE${NC}"
fi

exit $EXIT_CODE
